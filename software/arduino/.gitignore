### .gitignore for MSRT_EM files

## Ignore files built by windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


## Ignore files built by MS Office
[~][$]*


## Ignore files built by Visual Studio (see also https://gist.github.com/kmorcinek/2710267)

# User-specific files
*.suo
*.user
*.sln.docstates

# Do not keep Build results, but keep executable(s)
# Files under an excluded directory (e.g. "bin/") cannot be included again, therefore exclude only files (e.g. "bin/*")
**/.vs/*
**/obj/*
**/bin/*
**/readme/*
*.aps
*.bak
*.cache
*.ilk
*.lib
*.meta
*.ncb
*.obj
*.pch
*.pdb
*.sbr
*.scc
*.tlb
*.tlh
*.tli
*.vspscc
*.vssscc
*_i.c
*_p.c

# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/ which is used as an MSBuild target
!**/packages/build/

# Reinclude parent directory or directories of the files to be reincluded
!**/bin/Debug/
!**/bin/Release/
# Exclude all files in this reincluded directory ...
**/bin/Debug/*
**/bin/Release/*
# ... and exempt *.exe, which we want to keep
!**/bin/Debug/*.exe
!**/bin/Release/*.exe

# Diagnosis files
*.diagsession

## Ignore special DEBUG builds
**/*_DEBUG/*


## Ignore files created myself
*.log
*.analysis
# except in the DOCs folder
!01_Docs/**/*.log
!01_Docs/**/*.analysis
**/Logs/*
Copy*
*Copy
Kopie*
*Kopie
*Kopie.*
*.tmp
*[.-]alt
*.zip
*.7z
mytest.*
*.hex
*.mat
**/*t*mp*/**
t*mp


## Ignore some doxygen files
*.html
#doxygen
#latex
#Doxy*


## Ignore compare files
*.orig


## Ignore Platform IO files
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
